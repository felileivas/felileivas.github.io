---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Blog" description="Artículos sobre desarrollo de software, ciencia de datos y arquitectura cloud.">
  <link slot="head" rel="stylesheet" href="/assets/blog.css" />
  <section class="blog-header">
    <h1>Blog</h1>
    <p class="subtitle">Artículos sobre desarrollo de software, ciencia de datos y arquitectura cloud.</p>
  </section>

  <section class="posts-grid">
    {posts.map((post) => (
      <article class="post-card">
        <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      </article>
    ))}
  </section>
</Layout>


