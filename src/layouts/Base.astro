---
interface Props {
  title: string;
  description?: string;
  preloadPoster?: boolean;
  loadHeroScript?: boolean;
}

const {
  title,
  description = 'TICRAFT - Innovación en Software y Arquitectura Cloud',
  preloadPoster = false,
  loadHeroScript = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} | TICRAFT`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isBlogPage = pathname === '/blog';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Felipe Leiva" />
    <meta name="theme-color" content="#111827" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://ticraft.cl/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo TICRAFT.CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/site.css" />
    {preloadPoster && <link rel="preload" href="/images/hero-poster.avif" as="image" type="image/avif" fetchpriority="high" />}
    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="navbar">
      <a href="/" class="logo">TICRAFT<span class="accent">.CL</span></a>
      <nav aria-label="Principal">
        <button class="nav-toggle" type="button" popovertarget="menu-principal">Menú</button>
        <ul class="nav-links" id="menu-principal" popover="auto">
          <li><a href="/#servicios">Servicios</a></li>
          <li><a href="/blog" aria-current={isBlogPage ? 'page' : undefined}>Blog</a></li>
          <li><a href="mailto:contacto@ticraft.cl" class="btn-contact">Contáctanos</a></li>
        </ul>
      </nav>
    </header>

    <main><slot /></main>

    <footer>
      <div class="footer-content">
        <a href="/" class="footer-logo">TICRAFT<span class="accent">.CL</span></a>
        <div class="footer-links">
          <a href="/#servicios">Servicios</a>
          <a href="/blog">Blog</a>
          <a href="mailto:contacto@ticraft.cl">Contacto</a>
        </div>
        <p class="footer-copy">© {new Date().getFullYear()} TICRAFT.CL | Todos los derechos reservados</p>
        <a href="mailto:contacto@ticraft.cl" class="footer-email">contacto@ticraft.cl</a>
      </div>
    </footer>
    {loadHeroScript && <script is:inline src="/assets/hero.js" defer></script>}
  </body>
</html>
